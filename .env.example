# LangGraph SQLite Checkpointer
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# External APIs
# Serper API key for Google Web Search & News (https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Groq API key for LLM research synthesis and planning (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model Identifier (defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
